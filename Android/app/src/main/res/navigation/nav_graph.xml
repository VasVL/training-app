<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <!-- Temporary root destination while feature Fragments are being implemented /
         Временная корневая точка назначения, пока реализуются Fragment'ы фич -->
    <fragment
        android:id="@+id/mainFragment"
        android:name="com.vasev.trainingapp.MainFragment"
        android:label="@string/app_name" />

    <fragment
        android:id="@+id/userEditFragment"
        android:name="com.vasev.trainingapp.feature.auth.ui.useredit.UserEditFragment"
        android:label="@string/app_name">

        <argument
            android:name="request"
            app:argType="com.vasev.trainingapp.feature.auth.contract.UserEditRequest" />
    </fragment>

    <fragment
        android:id="@+id/userSelectFragment"
        android:name="com.vasev.trainingapp.feature.auth.ui.userselect.UserSelectFragment"
        android:label="@string/app_name" />

    <action
        android:id="@+id/action_global_mainFragment"
        app:destination="@id/mainFragment" />

    <action
        android:id="@+id/action_global_userEditFragment"
        app:destination="@id/userEditFragment">

        <argument
            android:name="request"
            app:argType="com.vasev.trainingapp.feature.auth.contract.UserEditRequest" />
    </action>

    <action
        android:id="@+id/action_global_userSelectFragment"
        app:destination="@id/userSelectFragment" />
</navigation>
