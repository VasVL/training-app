<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet permission — needed for Coil (image loading) and future network calls /
         Разрешение на интернет — нужно для Coil (загрузка картинок) и будущих сетевых вызовов -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".TrainingApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.TrainingApp">

        <!-- Launcher activity — single-activity host for Navigation Component /
             Стартовая activity — единственная activity-хост для Navigation Component -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
