<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/mainPlansFragment">

    <fragment
        android:id="@+id/mainPlansFragment"
        android:name="com.vasev.trainingapp.feature.main.ui.placeholder.MainPlaceholderFragment"
        android:label="@string/main_navigation_plans">

        <argument
            android:name="titleResId"
            android:defaultValue="@string/main_navigation_plans"
            app:argType="reference" />
    </fragment>

    <fragment
        android:id="@+id/mainCreateFragment"
        android:name="com.vasev.trainingapp.feature.main.ui.placeholder.MainPlaceholderFragment"
        android:label="@string/main_navigation_create">

        <argument
            android:name="titleResId"
            android:defaultValue="@string/main_navigation_create"
            app:argType="reference" />
    </fragment>

    <fragment
        android:id="@+id/mainTrainingFragment"
        android:name="com.vasev.trainingapp.feature.main.ui.placeholder.MainPlaceholderFragment"
