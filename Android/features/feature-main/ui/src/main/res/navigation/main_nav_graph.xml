        <argument
            android:name="titleResId"
            android:defaultValue="@string/main_drawer_settings"
            app:argType="reference" />
    </fragment>

    <fragment
        android:id="@+id/mainHelpFragment"
        android:name="com.vasev.trainingapp.feature.main.ui.placeholder.MainPlaceholderFragment"
        android:label="@string/main_drawer_help">

        <argument
            android:name="titleResId"
            android:defaultValue="@string/main_drawer_help"
